# Server Port
PORT=5000

# Groq API Key (Llama 3 reasoning). Optional - will fallback to deterministic rule engine if missing/unreachable.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Blockchain RPC Provider URL (Local Hardhat: http://127.0.0.1:8545 or Polygon Amoy: https://rpc-amoy.polygon.technology/)
RPC_URL=http://127.0.0.1:8545

# Deployer / Orchestrator Private Key
ORCHESTRATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Configurable tick rate in milliseconds (default: 2000 = 2 seconds)
TICK_INTERVAL_MS=2000
